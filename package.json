{
  "name": "jellywisp-desktop",
  "private": true,
  "version": "2.7.0",
  "description": "JellyWisp Desktop Music Client for Jellyfin",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "test": "tsx --test src/utils/audioMath.test.ts src/utils/layoutMath.test.ts",
    "lint": "tsc --noEmit",
    "desktop:dev": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --config electron-builder.json",
    "desktop:win": "vite build && electron-builder --win --config electron-builder.json",
    "desktop:mac": "vite build && electron-builder --mac --config electron-builder.json",
    "desktop:linux": "vite build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
